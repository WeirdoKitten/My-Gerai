# Salin file ini ke .env lalu isi dengan nilai asli.
# JANGAN pernah commit file .env (sudah di-ignore lewat .gitignore).

# Connection string Postgres self-hosted (server Garuda, lewat Cloudflare Tunnel
# atau jaringan internal Dokploy — sesuaikan host/port dengan setup Dokploy-nya).
DATABASE_URL="postgresql://user:password@host:5432/mygerai"

# Env var untuk sesi login (Pedagang/Admin) & storage foto ditambahkan
# saat fitur-fitur tsb dikerjakan (lihat docs/BACKLOG.md Fase 3).
