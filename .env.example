# Salin file ini ke .env lalu isi dengan nilai asli.
# JANGAN pernah commit file .env (sudah di-ignore lewat .gitignore).

# Connection string Postgres self-hosted (server Garuda, lewat Cloudflare Tunnel
# atau jaringan internal Dokploy — sesuaikan host/port dengan setup Dokploy-nya).
DATABASE_URL="postgresql://user:password@host:5432/mygerai"

# Base URL publik aplikasi — dipakai generate QR Menu absolut
# (https://<domain>/menu/<slug>). Dev lokal boleh dikosongkan (fallback
# http://localhost:3000); WAJIB diisi domain asli di produksi.
APP_URL="http://localhost:3000"

# --- Khusus server (Dokploy), TIDAK dipakai di dev lokal ---

# Isi "true" (persis) supaya container mengisi data demo saat start:
# 1 Admin + 4 Lapak contoh + Item. Idempoten & tanpa TRUNCATE (aman kalau
# lupa dimatikan). Kosongkan/hapus untuk server produksi sungguhan.
# Migrasi database SELALU jalan otomatis saat start, tidak perlu env ini.
SEED_DEMO=""

# Direktori simpan foto Item yang diunggah Pedagang. Dev lokal: kosongkan
# (fallback ".uploads/" di root repo). Produksi: "/app/uploads" (named volume
# Docker dimount di Dokploy — lihat docs/ARSITEKTUR-SISTEM.md ADR 2026-09-08).
UPLOADS_DIR=""

# --- Fase 6: Payment nyata (Midtrans) + Pencairan otomatis (Iris) ---
# Dev/test biarkan PAYMENT_PROVIDER/DISBURSEMENT_PROVIDER = "mock" (default kalau
# kosong) → pakai simulasi, tidak perlu kredensial Midtrans.
# Detail & langkah setup sandbox: docs/TEKNOLOGI.md §Payment Provider & Disbursement Provider Abstraction.

PAYMENT_PROVIDER=""              # kosong/"mock" (dev/test) | "midtrans" (staging/produksi)
MIDTRANS_SERVER_KEY=""           # dashboard(.sandbox).midtrans.com → Settings → Access Keys
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"   # "true" HANYA di produksi

DISBURSEMENT_PROVIDER=""         # kosong/"mock" | "iris"
DISBURSEMENT_ENABLED="false"     # "true" untuk mengaktifkan job Pencairan harian
IRIS_API_KEY=""                  # Iris "Creator" API key
IRIS_IS_PRODUCTION="false"

CRON_SECRET=""                   # bearer token untuk POST /api/cron/disburse
                                 # (di-set sama di Scheduled Job Dokploy yang memanggil endpoint ini)
